    {
      "id": "preparar",
      "label": "Preparar_Relatorio",
      "type": "static",
      "position": { "x": -700, "y": 0, "z": 0 },
      "inputs": [
        { "id": "preparar_in_0", "name": "in", "direction": "input", "type": "flow" }
      ],
      "outputs": [
        { "id": "preparar_out_0", "name": "out", "direction": "output", "type": "flow" }
      ],
      "parameters": {},
      "customLambdaBody": "// Gera um relatorio JSON grande o bastante para disparar a compactacao\nstd::filesystem::create_directories(\"workspace\");\n{\n    std::ofstream arx_out(\"workspace/eventos.json\", std::ios::binary | std::ios::trunc);\n    arx_out << \"{\\n  \\\"fonte\\\": \\\"checkout\\\",\\n  \\\"eventos\\\": [\\n\";\n    for (int i = 0; i < 80; ++i) {\n        arx_out << \"    {\\\"id\\\": \\\"evt-\" << i << \"\\\", \\\"tipo\\\": \\\"pagamento\\\", \"\n                << \"\\\"mensagem\\\": \\\"Evento de checkout processado com sucesso; cliente aguardando confirmacao e recibo detalhado do pedido.\\\", \"\n                << \"\\\"payload\\\": {\\\"pedido\\\": \\\"PED-\" << (1000 + i) << \"\\\", \\\"valor\\\": \" << (100 + i) << \", \"\n                << \"\\\"moeda\\\": \\\"BRL\\\", \\\"canal\\\": \\\"web\\\", \\\"tentativas\\\": 1}, \"\n                << \"\\\"tags\\\": [\\\"checkout\\\", \\\"pagamento\\\", \\\"confirmacao\\\"]}\";\n        if (i + 1 < 80) arx_out << \",\";\n        arx_out << \"\\n\";\n    }\n    arx_out << \"  ],\\n  \\\"sentinela\\\": \\\"SENTINELA-14-FIM\\\"\\n}\\n\";\n}\nstd::cout << \"[Preparar] workspace/eventos.json gerado (80 eventos)\\n\";"
    },
    {
      "id": "analista",
      "label": "Analista_de_Eventos",
      "type": "agent",
      "position": { "x": -300, "y": 0, "z": 0 },
      "inputs": [
        { "id": "analista_in_0", "name": "in", "direction": "input", "type": "flow" }
      ],
      "outputs": [
        { "id": "analista_out_0", "name": "out", "direction": "output", "type": "flow" }
      ],
      "parameters": {},
      "customLambdaBody": "",
      "agentSettings": {
        "inheritSandbox": true,
        "inheritModel": false,
        "model": {
          "skillPath": "skills/analista-eventos.md",
          "promptTemplate": "Leia o relatorio, recupere o original se houver [CCR:...] e grave workspace/resumo.md com a contagem e a sentinela. Responda apenas OK."
        },
        "inheritCodeMode": false,
        "codeMode": {
          "allowedTools": [
            "read",
            "write"
          ],
          "customScripts": []
        },
        "inheritMemory": true,
        "inheritCompression": true
      }
    },
