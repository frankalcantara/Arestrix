      "mcpSettings": {
        "server": "arestrix.dados",
        "tool": "regex_extract",
        "arguments": {
          "text": "{{input}}",
          "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
