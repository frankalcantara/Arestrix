        }
      ],
      "outputs": [
        {
          "id": "receber_out_0",
          "name": "out",
          "direction": "output",
          "type": "flow"
        }
      ],
      "parameters": {},
      "customLambdaBody": "namespace fs = std::filesystem;\nfs::create_directories(\"workspace\");\nif (!fs::exists(\"workspace/ticket.txt\")) {\n    const char* pick = std::getenv(\"ARESTRIX_EXAMPLE_TICKET\");\n    std::string name = (pick && *pick) ? pick : \"chamado_normal.txt\";\n    if (name.find(\"..\") != std::string::npos || name.find('/') != std::string::npos || name.find('\\\\') != std::string::npos)\n        throw std::runtime_error(\"ARESTRIX_EXAMPLE_TICKET deve ser so o nome de um arquivo de samples/\");\n    fs::copy_file(\"samples/\" + name, \"workspace/ticket.txt\", fs::copy_options::overwrite_existing);\n}\nstd::cout << \"[Receber] chamado em workspace/ticket.txt\\n\";",
      "requiredHeaders": [
        "<filesystem>",
        "<cstdlib>",
        "<stdexcept>"
      ]
    },
