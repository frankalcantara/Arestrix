    {
      "id": "svg_linter",
      "label": "Linter_Tipografia_Estatico",
      "type": "static",
      "position": {
        "x": 3000,
        "y": 330
      },
      "inputs": [
        {
          "id": "svg_linter_in_0",
          "name": "in",
          "direction": "input",
          "type": "flow"
        }
      ],
      "outputs": [
        {
          "id": "svg_linter_out_0",
          "name": "out",
          "direction": "output",
          "type": "flow"
        }
      ],
      "parameters": {},
      "customLambdaBody": "// Thread A: Linter Tipográfico e de Estrutura DOM (C++20)\nstd::cout << \"[Thread A] Iniciando auditoria tipográfica no SVG...\\n\";\n\nstd::ifstream file(\"workspace/scene.svg\");\nif (!file.is_open()) {\n    std::cerr << \"[Thread A - ERRO] Arquivo workspace/scene.svg não encontrado!\\n\";\n    return;\n}\n\nstd::string content((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());\nfile.close();\n\nbool violation = false;\n// Verificação de conformidade de regras de projeto\nif (content.find(\"feGaussianBlur\") != std::string::npos ||\n    content.find(\"feDropShadow\") != std::string::npos ||\n    content.find(\"text-shadow\") != std::string::npos) {\n    std::cout << \"[Thread A - VIOLAÇÃO] Detectado filtro de sombra ou blur! Proibido em elementos de texto.\\n\";\n    violation = true;\n}\n\n// Grava relatório da Thread A no quadro compartilhado (blackboard)\nstd::ofstream report(\"workspace/report_thread_a.txt\");\nreport << (violation ? \"FAIL: VIOLACAO_TIPOGRAFIA_DETECTADA\" : \"PASS: TIPOGRAFIA_LIMPA\");\nreport.close();\n\nstd::cout << \"[Thread A] Auditoria concluída.\\n\";"
    },
    {
      "id": "svg_smil",
      "label": "Auditor_Timeline_SMIL",
      "type": "static",
      "position": {
        "x": 3000,
        "y": 530
      },
      "inputs": [
        {
          "id": "svg_smil_in_0",
          "name": "in",
          "direction": "input",
          "type": "flow"
        }
      ],
      "outputs": [
        {
          "id": "svg_smil_out_0",
          "name": "out",
          "direction": "output",
          "type": "flow"
        }
      ],
      "parameters": {},
      "customLambdaBody": "// Thread B: Auditor Temporal e Animações SMIL (C++20)\nstd::cout << \"[Thread B] Iniciando auditoria de timelines e encadeamentos SMIL...\\n\";\n\nstd::ifstream file(\"workspace/scene.svg\");\nstd::string content((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());\nfile.close();\n\nbool timing_ok = true;\n\n// Checagem de congelamento de estado final\nif (content.find(\"<animate\") != std::string::npos && content.find(\"fill=\\\"freeze\\\"\") == std::string::npos) {\n    std::cout << \"[Thread B - ALERTA] Animação detectada sem retenção de estado (fill=\\\"freeze\\\").\\n\";\n    timing_ok = false;\n}\n\n// Checagem de escala sem pivô central\nif (content.find(\"type=\\\"scale\\\"\") != std::string::npos && content.find(\"transform-origin\") == std::string::npos) {\n    std::cout << \"[Thread B - ALERTA] animateTransform scale sem pivô explícito detectado.\\n\";\n    timing_ok = false;\n}\n\nstd::ofstream report(\"workspace/report_thread_b.txt\");\nreport << (timing_ok ? \"PASS: TIMELINE_SMIL_CONSISTENTE\" : \"WARN: TIMELINE_INSTAVEL\");\nreport.close();\n\nstd::cout << \"[Thread B] Análise de timeline concluída.\\n\";"
    },
