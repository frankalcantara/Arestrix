        "y": 0,
        "z": 0
      },
      "inputs": [
        {
          "id": "inicio_in_0",
          "name": "in",
          "direction": "input",
          "type": "flow"
        }
      ],
      "outputs": [
        {
          "id": "inicio_out_0",
