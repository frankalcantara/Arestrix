          "direction": "output",
          "type": "flow"
        }
      ],
      "parameters": {},
      "customLambdaBody": "std::cout << \"[Inicio] interacao a seguir\\n\";"
    },
    {
      "id": "pergunta",
      "label": "Pergunta_ao_Usuario",
      "type": "interaction",
      "position": {
        "x": 360,
        "y": 0,
        "z": 0
      },
      "inputs": [
        {
          "id": "pergunta_in_0",
          "name": "in",
          "direction": "input",
          "type": "flow"
        }
      ],
      "outputs": [
        {
          "id": "pergunta_out_0",
          "name": "out",
          "direction": "output",
          "type": "flow"
        }
      ],
      "parameters": {},
      "customLambdaBody": "",
      "interactionSettings": {
        "mode": "form",
        "schemaSource": "static",
        "form": {
          "title": "Confirme os dados",
          "description": "Responda para continuar o pipeline.",
          "context": {
            "markdown": "Este formulario simula uma pergunta ao operador."
          },
          "fields": [
            {
              "id": "tipo",
              "type": "choice",
              "label": "Tipo",
              "required": true,
              "options": [
                { "value": "pf", "label": "Pessoa fisica" },
                { "value": "pj", "label": "Pessoa juridica" }
              ]
            },
            {
              "id": "obs",
              "type": "text",
              "label": "Observacao",
              "required": false
            }
          ],
          "submitLabel": "Continuar",
          "cancelLabel": "Cancelar"
        },
        "channel": "any",
        "wait": true,
        "timeoutSeconds": 300,
        "onTimeout": "fail",
        "who": "any",
        "sensitive": false
      }
    },
    {
      "id": "entrega",
      "label": "Entrega_da_Resposta",
      "type": "output",
      "position": {
        "x": 720,
        "y": 0,
        "z": 0
