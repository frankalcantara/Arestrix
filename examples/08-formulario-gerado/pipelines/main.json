                "label": "Dados do cliente"
              }
            ]
          },
          "fields": []
        },
        "generator": {
          "provider": "deepseek",
          "model": "deepseek-flash",
          "temperature": 0.2,
          "fallback": "fail"
        },
        "channel": "any",
        "wait": true,
        "timeoutSeconds": 300,
        "onTimeout": "fail",
        "who": "any",
        "sensitive": false
      }
    },
    {
      "id": "entrega",
