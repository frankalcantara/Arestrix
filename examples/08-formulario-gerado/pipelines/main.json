      "parameters": {},
      "customLambdaBody": "std::ofstream(\"workspace/dados.md\") << \"# Dados do cliente\\n\\nNome: ACME Ltda\\nSegmento: industria\\nContato: setor de compras\\n\"; std::cout << \"[Dados] artefato criado\\n\";"
    },
    {
