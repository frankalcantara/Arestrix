{
  "name": "arestrix",
  "description": "Arestrix - Visual Node Graph Orchestrator for Concurrent Multi-Agent Pipelines with Taskflow C++20 and Three.js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs'); fs.cpSync('dist', 'CppCore/dist', {recursive:true});\"",
    "preview": "vite preview",
    "test": "vitest run",
    "app:dev": "python CppCore/dev.py",
    "submodule:check": "node scripts/update-submodules.mjs --check",
    "submodule:update": "node scripts/update-submodules.mjs --update",
    "check:secrets": "node scripts/check-secrets.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.35.3",
    "lucide": "^0.453.0",
    "monaco-editor": "^0.57.0",
    "three": "^0.169.0",
    "troika-three-text": "^0.50.1"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
