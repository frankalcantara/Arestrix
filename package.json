{
  "name": "arestrix",
  "description": "Arestrix - Visual Node Graph Orchestrator for Concurrent Multi-Agent Pipelines with Taskflow C++20 and Three.js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs'); fs.cpSync('dist', 'CppCore/dist', {recursive:true});\"",
    "preview": "vite preview",
    "test": "vitest run",
    "app:dev": "python CppCore/dev.py",
    "submodule:check": "node scripts/update-submodules.mjs --check",
    "submodule:update": "node scripts/update-submodules.mjs --update"
  },
  "dependencies": {
    "lucide": "^0.453.0",
    "monaco-editor": "^0.57.0",
    "three": "^0.169.0",
    "troika-three-text": "^0.50.1"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
