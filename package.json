{
  "name": "arestrix",
  "description": "Arestrix - Visual Node Graph Orchestrator for Concurrent Multi-Agent Pipelines with Taskflow C++20 and Three.js",
  "private": true,
  "version": "2.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankalcantara/Arestrix.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs'); fs.cpSync('dist', 'CppCore/dist', {recursive:true});\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:libraries": "node scripts/test-libraries.mjs",
    "test:libraries:live": "node scripts/test-libraries.mjs --live",
    "homologation:libraries": "node scripts/homologation-libraries.mjs",
    "homologation:libraries:live": "node scripts/homologation-libraries.mjs --live",
    "mock:github": "node scripts/mock-github-server.mjs",
    "app:dev": "python CppCore/dev.py",
    "submodule:check": "node scripts/update-submodules.mjs --check",
    "submodule:update": "node scripts/update-submodules.mjs --update",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:local-assets": "node scripts/check-local-assets.mjs",
    "check:skill-references": "node scripts/check-skill-references.mjs",
    "check:version": "node scripts/check-version.mjs",
    "release:manifest": "python scripts/release_manifest.py",
    "release:check": "python scripts/release_check.py",
    "release:portable": "python scripts/package_release.py",
    "release:installer": "python scripts/package_release.py --installer",
    "capture:screenshots": "node scripts/capture-screenshots.mjs && node scripts/capture-properties-screenshots.mjs",
    "capture:properties": "node scripts/capture-properties-screenshots.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.36.0",
    "lucide": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
