{
  "version": "1.0.0",
  "metadata": {
    "graphName": "Workspace Padrão",
    "description": "Workspace nativo inicial do Arestrix Studio",
    "targetStandard": "C++20",
    "compilerConfig": {
      "compiler": "msvc",
      "cppStandard": "C++20",
      "buildSystem": "cmake",
      "taskflowIncludePath": "include",
      "outputBinaryName": "agent_pipeline",
      "enableOpenMP": false,
      "enableCuda": false,
      "extraFlags": [
        "/std:c++20",
        "/EHsc",
        "/O2"
      ]
    },
    "version": "1.0.0",
    "globalDefaults": {
      "sandbox": {
        "isolationLevel": "container",
        "network": "egress_llm_only",
        "maxMemoryMB": 512,
        "timeoutSeconds": 300,
        "readOnlyMounts": [
          "plano.md",
          ".agents/"
        ],
        "readWriteMounts": [
          "aulas/"
        ]
      },
      "model": {
        "provider": "deepseek",
        "model": "deepseek-flash",
        "skillPath": ".agents/redigir-math/SKILL.md",
        "promptTemplate": "Processe o artigo  conforme as diretrizes do plano.md"
      },
      "codeMode": {
        "allowedTools": [
          "write",
          "edit",
          "read",
          "bash",
          "validate_svg"
        ],
        "customScripts": [
          "python scripts/audit_exercises.py"
        ]
      },
      "memory": {
        "enabled": false,
        "persistent": false,
        "readBlackboard": false,
        "writeBlackboard": false,
        "semanticLessons": false,
        "recordLessons": false,
        "allowedKeys": [],
        "domains": []
      }
    },
    "projectId": "default-workspace"
  },
  "nodes": [],
  "edges": []
}