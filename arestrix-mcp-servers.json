[
  {
    "args": [
      "--timeout",
      "10"
    ],
    "cachedTools": [
      {
        "description": "Efetua uma requisicao HTTP GET ou POST para uma URL externa e extrai o corpo.",
        "inputSchema": {
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST"
              ],
              "type": "string"
            },
            "url": {
              "description": "URL alvo",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        },
        "name": "fetch_url",
        "serverId": "mock-fetch"
      }
    ],
    "command": "mock",
    "env": {},
    "id": "mock-fetch",
    "isEnabled": true,
    "name": "Web & Fetch Gateway (MCP)",
    "transport": "stdio",
    "url": ""
  },
  {
    "args": [
      "--dir",
      "."
    ],
    "cachedTools": [
      {
        "description": "Le o conteudo integral de um arquivo local especificado pelo caminho relativo ou absoluto.",
        "inputSchema": {
          "properties": {
            "path": {
              "description": "Caminho do arquivo",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "read_file",
        "serverId": "mock-filesystem"
      },
      {
        "description": "Cria ou sobrescreve um arquivo no disco com o conteudo UTF-8 informado.",
        "inputSchema": {
          "properties": {
            "content": {
              "description": "Conteudo de texto",
              "type": "string"
            },
            "path": {
              "description": "Caminho de destino",
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "type": "object"
        },
        "name": "write_file",
        "serverId": "mock-filesystem"
      },
      {
        "description": "Lista todos os arquivos e pastas presentes no diretorio informado.",
        "inputSchema": {
          "properties": {
            "path": {
              "description": "Caminho da pasta",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "name": "list_directory",
        "serverId": "mock-filesystem"
      }
    ],
    "command": "mock",
    "env": {},
    "id": "mock-filesystem",
    "isEnabled": true,
    "name": "Filesystem Explorer (MCP)",
    "transport": "stdio",
    "url": ""
  }
]