root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,mjs,cjs,json,css,html,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{cpp,hpp,h,c}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
